<main class="container">
  <nav class="breadcrumb" aria-label="Ruta">
    <a href="/products">Productos</a>
    <span aria-hidden="true">/</span>
    <a href="/products?category={{product.category}}">{{categoryLabel product.category}}</a>
    <span aria-hidden="true">/</span>
    <span>{{product.title}}</span>
  </nav>

  {{#with product}}
    <article class="detail">
      <div class="detail__media">
        <img src="{{thumbnail}}" alt="{{title}}" />
      </div>

      <div class="detail__info">
        <span class="product-card__category">{{categoryLabel category}}</span>
        <h1 class="detail__title">{{title}}</h1>
        <p class="detail__code">Código {{code}}</p>
        <p class="detail__price">{{money price}}</p>

        {{#if (eq stock 0)}}
          <span class="badge badge--out">Sin stock</span>
        {{else if (lte stock 3)}}
          <span class="badge badge--warn">¡Últimas {{stock}} unidades!</span>
        {{else}}
          <span class="badge badge--ok">En stock · {{stock}} unidades</span>
        {{/if}}

        <p class="detail__description">{{description}}</p>

        {{#if (gt stock 0)}}
          <div class="detail__buy">
            <div class="stepper" data-stepper data-max="{{stock}}">
              <button class="stepper__btn" type="button" data-step="-1" aria-label="Quitar una unidad">−</button>
              <input class="stepper__value" id="qty" type="number" min="1" max="{{stock}}" value="1" aria-label="Cantidad" />
              <button class="stepper__btn" type="button" data-step="1" aria-label="Agregar una unidad">+</button>
            </div>
            <button class="btn btn--primary detail__add" type="button" data-add-to-cart="{{_id}}" data-qty-input="#qty">
              Agregar al carrito
            </button>
          </div>
        {{else}}
          <button class="btn btn--block" type="button" disabled>Producto agotado</button>
        {{/if}}

        <ul class="detail__perks">
          <li>🔒 Tu carrito queda guardado en tu cuenta</li>
          <li>📦 Stock actualizado al momento</li>
        </ul>
      </div>
    </article>
  {{/with}}

  {{#if related.length}}
    <section class="section">
      <div class="section__head">
        <h2>También te puede interesar</h2>
      </div>
      <div class="product-grid">
        {{#each related}}{{> productCard}}{{/each}}
      </div>
    </section>
  {{/if}}
</main>

<script type="module">
  // Selector de cantidad: no deja bajar de 1 ni pasar el stock disponible.
  const stepper = document.querySelector("[data-stepper]");
  if (stepper) {
    const input = stepper.querySelector("input");
    const max = Number(stepper.dataset.max);
    const clamp = (value) => Math.min(max, Math.max(1, Number(value) || 1));
    stepper.addEventListener("click", (event) => {
      const button = event.target.closest("[data-step]");
      if (button) input.value = clamp(Number(input.value) + Number(button.dataset.step));
    });
    input.addEventListener("change", () => (input.value = clamp(input.value)));
  }
</script>
