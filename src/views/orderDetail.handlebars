<main class="container">
  <header class="page-head">
    <p class="eyebrow">Compra {{order.code}}</p>
    <h1>{{#if justPlaced}}Compra registrada{{else}}Detalle de la compra{{/if}}</h1>
    <p><span class="badge {{paymentState.badge}}">{{paymentState.label}}</span></p>
  </header>

  {{#if justPlaced}}
    <p class="notice notice--ok" role="status">✓ Reservamos tus productos con el número <strong>{{order.code}}</strong>. No pudimos abrir Mercado Pago: puedes pagar desde acá.</p>
  {{else if justReturned}}
    <p class="notice {{#if (eq order.status "pagada")}}notice--ok{{/if}}" role="status">{{paymentState.message}}</p>
  {{else}}
    <p class="order-state">{{paymentState.message}}</p>
  {{/if}}

  <div class="cart">
    <section class="cart__items" aria-label="Productos comprados">
      {{#each items}}
        <article class="order-line">
          <img class="order-line__media" src="{{thumbnail}}" alt="" />
          <div class="order-line__info">
            <a href="/products/{{product}}"><strong>{{title}}</strong></a>
            <span>{{quantity}} × {{money price}}</span>
          </div>
          <strong class="order-line__subtotal">{{money subtotal}}</strong>
        </article>
      {{/each}}
    </section>

    <aside class="cart__summary">
      <h2>Resumen</h2>
      <dl>
        <div><dt>Fecha</dt><dd><time datetime="{{isoDate order.createdAt}}">{{dateTime order.createdAt}}</time></dd></div>
        <div><dt>Envío</dt><dd>A coordinar</dd></div>
        {{#if order.payment.id}}<div><dt>Pago</dt><dd>N.º {{order.payment.id}}</dd></div>{{/if}}
        <div class="cart__total"><dt>Total</dt><dd>{{money order.total}}</dd></div>
      </dl>
      {{#if canPay}}
        <button class="btn btn--primary btn--block" type="button" data-pay-order="{{order._id}}">Pagar con Mercado Pago</button>
      {{/if}}
      <a class="btn btn--block" href="/orders">Mis compras</a>
      <a class="btn btn--ghost btn--block" href="/products">Seguir comprando</a>
      <p class="demo-note">Pago de prueba con Mercado Pago: no se cobra dinero real ni se hacen envíos.</p>
    </aside>
  </div>
</main>

<script src="/js/checkout.js" type="module"></script>
