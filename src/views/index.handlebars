<!-- Genero una vista central -->

<main class="landing-page">
  <section class="hero landing-hero">
    
    <div class="hero__inner">
      <p class="hero__eyebrow">Tienda gamer</p>
      <h1 class="hero__title">Equipa tu setup con productos de alto rendimiento</h1>
      <p class="hero__text">Explora el catalogo, agrega varios productos desde
        detalle o listado y revisa tu carrito en una vista dedicada.</p>
      <div class="landing-actions">
        <a class="btn btn--primary" href="/products">Ver productos</a>
        <a class="btn" href="/cart">Ir al carrito</a>
      </div>
    </div>
  </section>

  <section class="catalog-shell landing-info">
    <article class="landing-card">
      <h2>Flujo rapido</h2>
      <p>Crea o reutiliza tu carrito automaticamente y agrega productos sin
        perder contexto.</p>
    </article>
    <article class="landing-card">
      <h2>Filtros avanzados</h2>
      <p>Ordena por precio, pagina resultados y filtra por categoria,
        disponibilidad o texto.</p>
    </article>
    <article class="landing-card">
      <h2>Vista de carrito</h2>
      <p>Visualiza cantidad, subtotal por item y total final de tu compra.</p>
    </article>
  </section>
</main>