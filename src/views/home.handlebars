<main class="container">
  <header class="page-head">
    <p class="eyebrow">Catálogo</p>
    <h1>{{#if category}}{{categoryLabel category}}{{else}}Todos los productos{{/if}}</h1>
    <p>{{totalDocs}} {{#if (eq totalDocs 1)}}producto encontrado{{else}}productos encontrados{{/if}}{{#if q}} para “{{q}}”{{/if}}</p>
  </header>

  <nav class="chips" aria-label="Categorías">
    {{#each categoryChips}}
      <a class="chip {{#if active}}chip--active{{/if}}" href="{{link}}" {{#if active}}aria-current="true"{{/if}}>
        {{#if icon}}<span aria-hidden="true">{{icon}}</span>{{/if}}{{label}}{{#if count}} <small>{{count}}</small>{{/if}}
      </a>
    {{/each}}
  </nav>

  <form class="toolbar" method="GET" action="/products" role="search">
    {{#if category}}<input type="hidden" name="category" value="{{category}}" />{{/if}}
    <div class="toolbar__search">
      <label class="sr-only" for="q">Buscar</label>
      <input class="input" id="q" name="q" type="search" value="{{q}}" placeholder="Buscar por nombre o descripción…" maxlength="60" />
    </div>
    <label class="check">
      <input type="checkbox" name="available" value="1" {{#if available}}checked{{/if}} data-autosubmit />
      Solo con stock
    </label>
    <div class="field field--inline">
      <label for="sort">Ordenar</label>
      <select id="sort" name="sort" data-autosubmit>
        <option value="" {{#unless sort}}selected{{/unless}}>Relevancia</option>
        <option value="asc" {{#if (eq sort "asc")}}selected{{/if}}>Menor precio</option>
        <option value="desc" {{#if (eq sort "desc")}}selected{{/if}}>Mayor precio</option>
      </select>
    </div>
    <div class="field field--inline">
      <label for="limit">Mostrar</label>
      <select id="limit" name="limit" data-autosubmit>
        {{#each pageSizes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}
      </select>
    </div>
    <button class="btn btn--primary" type="submit">Buscar</button>
    {{#if hasFilters}}<a class="btn btn--ghost" href="/products">Limpiar</a>{{/if}}
  </form>

  <section class="product-grid">
    {{#each products}}
      {{> productCard}}
    {{else}}
      <div class="empty-state">
        <h3>No encontramos productos</h3>
        <p>Prueba con otra búsqueda o quita algún filtro.</p>
        <a class="btn" href="/products">Ver todo el catálogo</a>
      </div>
    {{/each}}
  </section>

  {{#if showPagination}}
    <nav class="pagination" aria-label="Paginación">
      {{#if prevLink}}<a class="pagination__link" href="{{prevLink}}" aria-label="Página anterior">←</a>{{/if}}
      {{#each pages}}
        <a class="pagination__link {{#if active}}pagination__link--active{{/if}}" href="{{link}}" {{#if active}}aria-current="page"{{/if}}>{{number}}</a>
      {{/each}}
      {{#if nextLink}}<a class="pagination__link" href="{{nextLink}}" aria-label="Página siguiente">→</a>{{/if}}
    </nav>
  {{/if}}
</main>

<script type="module">
  // Los filtros de orden, cantidad y stock se aplican al cambiar, sin tocar "Buscar".
  document.querySelectorAll("[data-autosubmit]").forEach((el) =>
    el.addEventListener("change", () => el.form.requestSubmit())
  );
</script>
