<main class="container">
  <header class="page-head">
    <p class="eyebrow">Tu compra</p>
    <h1>Mi carrito</h1>
  </header>

  <div class="cart" data-cart="{{cartId}}">
    <section class="cart__items" aria-label="Productos en el carrito">
      {{#each items}}
        <article class="cart-item" data-item="{{product._id}}" data-price="{{product.price}}" data-stock="{{product.stock}}">
          <a class="cart-item__media" href="/products/{{product._id}}">
            <img src="{{product.thumbnail}}" alt="" />
          </a>
          <div class="cart-item__info">
            <span class="product-card__category">{{categoryLabel product.category}}</span>
            <a class="cart-item__title" href="/products/{{product._id}}">{{product.title}}</a>
            <span class="cart-item__unit">{{money product.price}} c/u · {{product.stock}} en stock</span>
          </div>
          <div class="stepper stepper--sm">
            <button class="stepper__btn" type="button" data-qty="-1" aria-label="Quitar una unidad">−</button>
            <span class="stepper__value" data-qty-value>{{quantity}}</span>
            <button class="stepper__btn" type="button" data-qty="1" aria-label="Agregar una unidad">+</button>
          </div>
          <strong class="cart-item__subtotal" data-subtotal>{{money subtotal}}</strong>
          <button class="btn btn--icon btn--ghost" type="button" data-remove aria-label="Quitar {{product.title}}">✕</button>
        </article>
      {{/each}}

      <div class="empty-state" data-empty {{#if items.length}}hidden{{/if}}>
        <h3>Tu carrito está vacío</h3>
        <p>Explora el catálogo y agrega tus periféricos favoritos.</p>
        <a class="btn btn--primary" href="/products">Ver productos</a>
      </div>
    </section>

    <aside class="cart__summary" data-summary {{#unless items.length}}hidden{{/unless}}>
      <h2>Resumen</h2>
      <dl>
        <div><dt>Unidades</dt><dd data-total-items>{{totalItems}}</dd></div>
        <div><dt>Envío</dt><dd>A coordinar</dd></div>
        <div class="cart__total"><dt>Total</dt><dd data-total-amount>{{money totalAmount}}</dd></div>
      </dl>
      <a class="btn btn--primary btn--block" href="/products">Seguir comprando</a>
      <button class="btn btn--danger btn--block" type="button" data-empty-cart>Vaciar carrito</button>
    </aside>
  </div>
</main>

<script src="/js/cart.js" type="module"></script>
