<main class="catalog-page">
  <section class="hero">
    <div class="hero__inner">
      <h1 class="hero__title">Carrito {{cartId}}</h1>
    </div>
  </section>

  <section class="catalog-shell">
    <section class="cart-summary">
      <article class="cart-summary__card">
        <p class="product-card__meta-label">Items totales</p>
        <p class="cart-summary__value">{{totalItems}}</p>
      </article>
      <article class="cart-summary__card">
        <p class="product-card__meta-label">Total</p>
        <p class="cart-summary__value">${{totalAmount}}</p>
      </article>
      <a class="btn btn--primary" href="/products">Seguir comprando</a>
    </section>

    <section class="cart-list">
      {{#each products}}
        <article class="cart-item">
          <img
            src="{{this.product.thumbnail}}"
            alt="{{this.product.title}}"
            class="cart-item__image"
          />

          <div class="cart-item__content">
            <p class="product-card__category">{{this.product.category}}</p>
            <h3 class="product-card__title">{{this.product.title}}</h3>
          </div>

          <div class="cart-item__meta">
            <p class="product-card__meta-label">Cantidad</p>
            <p class="product-card__stock">{{this.quantity}}</p>
          </div>

          <div class="cart-item__meta">
            <p class="product-card__meta-label">Precio unitario</p>
            <p class="product-card__price">${{this.product.price}}</p>
          </div>

          <div class="cart-item__meta">
            <p class="product-card__meta-label">Subtotal</p>
            <p class="product-card__price">${{this.subtotal}}</p>
          </div>

          <a class="btn" href="/products/{{this.product._id}}">Ver producto</a>
        </article>
      {{else}}
        <div class="empty-state">
          <h3>Este carrito esta vacio</h3>
          <p>Agrega productos desde el catalogo para verlos aqui.</p>
          <a class="btn btn--primary" href="/products">Ir a productos</a>
        </div>
      {{/each}}
    </section>
  </section>
</main>