<article class="product-card">
  <a class="product-card__media" href="/products/{{_id}}" tabindex="-1" aria-hidden="true">
    <img src="{{thumbnail}}" alt="" loading="lazy" />
    {{#if (eq stock 0)}}
      <span class="product-card__flag product-card__flag--out">Sin stock</span>
    {{else if (lte stock 3)}}
      <span class="product-card__flag">Últimas {{stock}}</span>
    {{/if}}
  </a>
  <div class="product-card__body">
    <span class="product-card__category">{{categoryLabel category}}</span>
    <h3 class="product-card__title"><a href="/products/{{_id}}">{{title}}</a></h3>
  </div>
  <div class="product-card__footer">
    <strong class="product-card__price">{{money price}}</strong>
    <button class="btn btn--primary btn--sm" type="button" data-add-to-cart="{{_id}}" {{#if (eq stock 0)}}disabled{{/if}}>
      {{#if (eq stock 0)}}Agotado{{else}}Agregar{{/if}}
    </button>
  </div>
</article>
