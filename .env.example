PORT=8081
# Cadena de conexion de MongoDB Atlas. Usa una base propia (ej. /tienda-gamer) para no mezclar con la entrega.
URI_MONGODB=mongodb+srv://usuario:password@cluster.mongodb.net/tienda-gamer
# Opcional: nombre de la base (por defecto tienda-gamer). Va aparte de la cadena, así dos apps pueden compartir clúster.
DB_NAME=
# Clave para firmar los JWT: un texto largo y aleatorio (ej. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
JWT_SECRET=
# Opcional: cuenta de administrador que crea `npm run seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
NODE_ENV=development
# Opcional: saltos de proxy delante de la app (en Render, 1) para que el límite de intentos de login vea la IP real.
TRUST_PROXY=
# Access Token de PRUEBA de Mercado Pago (panel de desarrolladores → tu aplicación → Credenciales de prueba).
# Sin él, la tienda funciona pero no ofrece pagar. Nunca va en el repo ni en el chat.
MP_ACCESS_TOKEN=
# Dirección pública del sitio, para los links de los emails (ej. https://tienda-gamer-fij2.onrender.com).
# En producción es obligatoria: el link nunca se arma con el encabezado Host del pedido.
APP_URL=
# Envío de emails con Brevo (recuperar contraseña). Sin clave, en desarrollo el email sale por consola.
BREVO_API_KEY=
# Remitente verificado en Brevo y nombre que ve quien recibe el email.
MAIL_FROM=
MAIL_FROM_NAME=Tienda Gamer
