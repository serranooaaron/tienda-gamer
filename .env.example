PORT=8081
# Cadena de conexion de MongoDB Atlas. Usa una base propia (ej. /tienda-gamer) para no mezclar con la entrega.
URI_MONGODB=mongodb+srv://usuario:password@cluster.mongodb.net/tienda-gamer
# Clave para firmar los JWT: un texto largo y aleatorio (ej. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
JWT_SECRET=
# Opcional: cuenta de administrador que crea `npm run seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
NODE_ENV=development
# Opcional: saltos de proxy delante de la app (en Render, 1) para que el límite de intentos de login vea la IP real.
TRUST_PROXY=
